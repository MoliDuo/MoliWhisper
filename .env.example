# 复制为 .env 再改：cp .env.example .env
# 生成随机 Token：openssl rand -hex 24

# 必填。MoliWhisper 设置里的「Token」填同一个值
MOLI_ASR_TOKEN=

# 以下都可以不改
# 对外端口
#MOLI_PORT=8765
# 监听地址；只想让 Tailscale 访问就填本机的 100.x.y.z
#MOLI_BIND=0.0.0.0
# 模型：Hugging Face 名字，或 Qwen/Qwen3-ASR-0.6B
#MOLI_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# 强制语言，例如 Chinese；留空自动检测
#MOLI_ASR_LANGUAGE=
# 给模型的上下文，如人名、术语
#MOLI_ASR_CONTEXT=
# vLLM 占用显存的比例；显卡还要做别的事就调低
#MOLI_GPU_MEMORY_UTILIZATION=0.8
# 访问不了 huggingface.co 时换镜像，例如 https://hf-mirror.com
#HF_ENDPOINT=https://huggingface.co
