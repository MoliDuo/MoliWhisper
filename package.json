{
  "name": "moli-whisper",
  "private": true,
  "version": "2.0.108",
  "description": "Moli Whisper: hold-to-talk dictation for macOS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "format": "prettier --write ui scripts/release vite.config.ts",
    "format:check": "prettier --check ui scripts/release vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/release",
    "test:release": "node --test \"scripts/release/*.test.ts\"",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run test:release && pnpm run build && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  },
  "packageManager": "pnpm@11.17.0"
}
